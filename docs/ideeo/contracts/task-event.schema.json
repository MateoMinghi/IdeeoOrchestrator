{
  "$defs": {
    "AccountChoice": {
      "additionalProperties": false,
      "properties": {
        "account_id": {
          "title": "Account Id",
          "type": "string"
        },
        "currency": {
          "title": "Currency",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "account_id",
        "label",
        "currency"
      ],
      "title": "AccountChoice",
      "type": "object"
    },
    "BalanceResult": {
      "additionalProperties": false,
      "properties": {
        "account": {
          "$ref": "#/$defs/AccountChoice"
        },
        "available_to_spend": {
          "$ref": "#/$defs/Money"
        },
        "kind": {
          "const": "balance",
          "default": "balance",
          "title": "Kind",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "provenance": {
          "default": "synthetic",
          "enum": [
            "synthetic",
            "bank"
          ],
          "title": "Provenance",
          "type": "string"
        }
      },
      "required": [
        "account",
        "available_to_spend",
        "observed_at"
      ],
      "title": "BalanceResult",
      "type": "object"
    },
    "ClarificationResult": {
      "additionalProperties": false,
      "properties": {
        "choices": {
          "items": {
            "$ref": "#/$defs/AccountChoice"
          },
          "title": "Choices",
          "type": "array"
        },
        "kind": {
          "const": "clarification",
          "default": "clarification",
          "title": "Kind",
          "type": "string"
        },
        "reason": {
          "enum": [
            "account_required",
            "ambiguous_request",
            "preference_unavailable"
          ],
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "reason"
      ],
      "title": "ClarificationResult",
      "type": "object"
    },
    "Money": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Amount"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "title": "Money",
      "type": "object"
    },
    "PublicError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "retryable"
      ],
      "title": "PublicError",
      "type": "object"
    },
    "TaskView": {
      "additionalProperties": false,
      "properties": {
        "api_version": {
          "const": "1",
          "default": "1",
          "title": "Api Version",
          "type": "string"
        },
        "conversation_id": {
          "format": "uuid",
          "title": "Conversation Id",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/PublicError"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        },
        "result": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "balance": "#/$defs/BalanceResult",
                  "clarification": "#/$defs/ClarificationResult",
                  "unsupported": "#/$defs/UnsupportedResult"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/BalanceResult"
                },
                {
                  "$ref": "#/$defs/ClarificationResult"
                },
                {
                  "$ref": "#/$defs/UnsupportedResult"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result"
        },
        "status": {
          "enum": [
            "processing",
            "completed",
            "failed",
            "interrupted"
          ],
          "title": "Status",
          "type": "string"
        },
        "task_id": {
          "format": "uuid",
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "conversation_id",
        "status",
        "created_at"
      ],
      "title": "TaskView",
      "type": "object"
    },
    "UnsupportedResult": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "unsupported",
          "default": "unsupported",
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "UnsupportedResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "const": "1",
      "default": "1",
      "title": "Api Version",
      "type": "string"
    },
    "event_id": {
      "title": "Event Id",
      "type": "integer"
    },
    "phase": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Phase"
    },
    "task": {
      "anyOf": [
        {
          "$ref": "#/$defs/TaskView"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "task_id": {
      "format": "uuid",
      "title": "Task Id",
      "type": "string"
    },
    "type": {
      "enum": [
        "accepted",
        "progress",
        "completed",
        "failed",
        "interrupted"
      ],
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "task_id",
    "type"
  ],
  "title": "TaskEvent",
  "type": "object"
}
