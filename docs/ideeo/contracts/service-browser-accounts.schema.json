{
  "$defs": {
    "BrowserAccount": {
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "connection_id": {
              "type": "null"
            },
            "state_file_env": {
              "type": "string"
            }
          },
          "required": [
            "state_file_env"
          ]
        },
        {
          "properties": {
            "connection_id": {
              "type": "string"
            },
            "state_file_env": {
              "type": "null"
            }
          },
          "required": [
            "connection_id"
          ]
        }
      ],
      "properties": {
