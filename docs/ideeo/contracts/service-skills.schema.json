{
  "$defs": {
    "SkillArtifact": {
      "additionalProperties": false,
      "properties": {
        "instructions": {
          "maxLength": 32000,
          "minLength": 1,
          "title": "Instructions",
          "type": "string"
        },
        "provider": {
          "enum": [
            "uber",
            "uber_eats",
            "rappi",
            "opentable",
            "google_businesses",
            "doctoralia",
            "didi_food",
            "didi_rides"
          ],
          "title": "Provider",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "pattern": "^[A-Za-z0-9._-]{1,100}$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "version",
        "sha256",
        "instructions"
      ],
      "title": "SkillArtifact",
      "type": "object"
    },
    "SkillQualification": {
      "additionalProperties": false,
      "properties": {
        "accepted_by": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Accepted By",
          "type": "string"
        },
        "evidence_references": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Evidence References",
          "type": "array"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "independent_review_reference": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Independent Review Reference",
          "type": "string"
        },
        "model_route": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Model Route",
          "type": "string"
        },
        "permissions": {
          "items": {
            "enum": [
              "prepare",
              "disclose",
              "commit",
              "dispatch",
              "reconcile",
              "cancel",
              "track",
              "refund"
            ],
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Permissions",
          "type": "array"
        },
        "provider": {
          "enum": [
            "uber",
            "uber_eats",
            "rappi",
            "opentable",
            "google_businesses",
            "doctoralia",
            "didi_food",
            "didi_rides"
          ],
          "title": "Provider",
          "type": "string"
        },
        "reference": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Reference",
          "type": "string"
        },
        "revoked": {
          "default": false,
          "title": "Revoked",
          "type": "boolean"
        },
        "route_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Route Digest",
          "type": "string"
        },
        "runtime_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runtime Sha256"
        },
        "skill_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Skill Sha256",
          "type": "string"
        },
        "skill_version": {
          "pattern": "^[A-Za-z0-9._-]{1,100}$",
          "title": "Skill Version",
          "type": "string"
        },
        "tenant_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Tenant Id",
          "type": "string"
        }
      },
      "required": [
        "reference",
        "tenant_id",
        "provider",
        "route_digest",
        "skill_version",
        "skill_sha256",
        "model_route",
        "permissions",
        "evidence_references",
        "independent_review_reference",
        "accepted_by",
        "expires_at"
      ],
      "title": "SkillQualification",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/$defs/SkillArtifact"
      },
      "maxItems": 1000,
      "title": "Artifacts",
      "type": "array"
    },
    "qualifications": {
      "items": {
        "$ref": "#/$defs/SkillQualification"
      },
      "maxItems": 1000,
      "title": "Qualifications",
      "type": "array"
    }
  },
  "title": "SkillConfiguration",
  "type": "object"
}
